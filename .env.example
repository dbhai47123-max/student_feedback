# Copy this file to .env and adjust as needed.
# All values have working defaults, so .env is optional for local testing.

PORT=3000

# Secret used to sign login sessions (JWTs). Use a long random string
# in any real deployment, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# With NODE_ENV=production the server refuses to start without one.
JWT_SECRET=dev-secret-change-me

# Set to "production" when deploying behind HTTPS: the session cookie
# is then marked Secure and a real JWT_SECRET is required.
# NODE_ENV=production

# Credentials for the auto-created admin account (only created once,
# the first time the server runs and no admin exists yet).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
